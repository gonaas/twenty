# Copy to .env and fill in. Every variable is read by src/config/env.ts.

# HTTP
PORT=8080
LOG_LEVEL=info

# Shared with the Twenty app: UNIPILE_API_KEY / UNIPILE_ACCOUNT_ID must match these.
API_KEY=replace-with-a-long-random-string
ACCOUNT_ID=wyre-linkedin

# SQLite snapshot location (Railway volume mount point in production).
DATA_DIR=./data

# Twenty webhook resolver of the linkedin-unipile app and its shared secret (UNIPILE_WEBHOOK_SECRET).
# Leave both empty to disable webhooks.
WEBHOOK_URL=https://<twenty-server-host>/webhooks/server/eb40d474-181f-4dd9-9fe0-b120e9b07f77
WEBHOOK_SECRET=replace-with-the-webhook-secret

# LinkedIn session cookie, minted with `yarn session:login`. JSESSIONID is optional.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Residential sticky proxy (same country as the LinkedIn account). Leave empty to go direct.
PROXY_SERVER=http://proxy-host:port
PROXY_USERNAME=
PROXY_PASSWORD=

# Browser identity; keep locale and timezone consistent with the account.
BROWSER_LOCALE=es-ES
BROWSER_TIMEZONE=Europe/Madrid
BROWSER_HEADLESS=true
# Optional override; by default the browser's own user agent is used with "HeadlessChrome" replaced by "Chrome".
BROWSER_USER_AGENT=

# Pacing
POLL_INTERVAL_MINUTES=30
POLL_JITTER_MINUTES=10
KEEPALIVE_MINUTES=30
MIN_REQUEST_INTERVAL_MS=4000
REQUEST_JITTER_MS=3000
RATE_LIMIT_BACKOFF_MINUTES=60
DAILY_PROFILE_LOOKUP_BUDGET=100
CONVERSATIONS_PER_REFRESH=40
CONNECTIONS_PAGE_SIZE=40
CONVERSATION_PAGES_MAX=25
THREAD_PAGES_MAX=10
MESSAGE_BACKFILL_DAYS=90
